# ==============================================================================
# Environment Configuration Template for Music Similarity Research Platform
# Copy this file to .env and configure local settings as needed.
# ==============================================================================

# Server Network Settings
MUSIC_API_HOST=0.0.0.0
MUSIC_API_PORT=8000

# Directory Paths (Relative to repository root or absolute)
MUSIC_DATA_DIR=data
MUSIC_FEATURES_DIR=features
MUSIC_MODELS_DIR=models
MUSIC_RESULTS_DIR=results
MUSIC_TEMP_DIR=temp_uploads
MUSIC_METADATA_PATH=data/metadata.csv

# Audio Processing Parameters
MUSIC_SAMPLE_RATE=22050
MUSIC_MIN_UPLOAD_DURATION_SEC=60.0
MUSIC_MAX_UPLOAD_SIZE_BYTES=52428800

# Pipeline Analysis Thresholds
MUSIC_COSINE_THRESHOLD=0.30
MUSIC_SIMILARITY_FLOOR=0.45
MUSIC_P_CRITICAL=0.01
MUSIC_P_BORDERLINE=0.10
MUSIC_CREATIVE_THRESHOLD=0.24
MUSIC_MAX_SURVIVORS=15
MUSIC_GENRE_MIN_SAMPLE=30
MUSIC_NARROW_MIN_SURVIVORS=5
MUSIC_NULL_SAMPLE_PAIRS=2000

# Optional LLM Studio Suggestion Integration (Leave empty to use deterministic suggestions)
MUSIC_SIMILARITY_LLM_KEY=
MUSIC_SIMILARITY_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
